# Copy to .env and fill from CDK Auth stack outputs.
#
# After `floci start` and `pnpm --filter infra run deploy`, copy:
#   Auth.UserPoolId        → VITE_COGNITO_USER_POOL_ID
#   Auth.UserPoolClientId  → VITE_COGNITO_USER_POOL_CLIENT_ID
#   Auth.UserPoolRegion    → VITE_COGNITO_REGION
#
# Re-print outputs any time:
#   pnpm --filter infra exec cdklocal deploy --outputs-file /dev/stdout
# or:
#   aws cloudformation describe-stacks --stack-name Auth \
#     --query "Stacks[0].Outputs" --output table \
#     --endpoint-url http://localhost:4566
#
# Production: same keys, real pool/client/region from the prod Auth stack.
# Leave VITE_AWS_ENDPOINT_URL empty so the browser talks to AWS, not Floci.
# These VITE_ values are public (SPA Cognito config). Do not put secrets here.

# Cognito user pool — which directory this SPA signs into
VITE_COGNITO_USER_POOL_ID=

# App client on that pool (no secret; this is a public SPA)
VITE_COGNITO_USER_POOL_CLIENT_ID=

# Region of the pool (must match the stack)
VITE_COGNITO_REGION=us-east-1

# Local only: Floci edge. Empty in prod.
VITE_AWS_ENDPOINT_URL=http://localhost:4566
